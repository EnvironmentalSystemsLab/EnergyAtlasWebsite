    <section id="features">
      <div class="container">
        <h2 class="feature-section-label">Features</h2>
        
        <div class="features-grid">
          <div class="feature-item">
            <h3>Agentic Digital Twin</h3>
            <div class="feature-visual">
              <video class="feature-screen-capture" autoplay muted loop playsinline aria-label="Agentic digital twin interface showing integrated city data">
                <source src="/assets/video/ArchetypeCombined.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="feature-copy">
              <EditorialIcon name="digital-twin" class="feature-icon" />
              <p>Explore connected city models with agentic reasoning and assistance.</p>
              <ul role="list">
                <li>Connect building, parcel, zoning, and energy data.</li>
                <li>Find data gaps and assist model setup.</li>
                <li>Map local archetypes and energy results.</li>
              </ul>
            </div>
          </div>
          
          <div class="feature-item">
            <h3>City-Scale Energy Insights</h3>
            <div class="feature-visual">
              <video class="feature-screen-capture" autoplay muted loop playsinline aria-label="City-scale energy insights showing building demand and simulation results">
                <source src="/assets/video/ResultSelection.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="feature-copy">
              <EditorialIcon name="energy-insights" class="feature-icon" />
              <p>Turn city-scale energy simulations into actionable climate plans.</p>
              <ul role="list">
                <li>Forecast hourly loads for power and grid studies.</li>
                <li>Compare electrification and retrofit demand and emissions.</li>
                <li>Prioritize climate action by cost, payback, and incentives.</li>
              </ul>
            </div>
          </div>
          
          <div class="feature-item">
            <h3>Distributed Energy Resources Integration</h3>
            <div class="feature-visual">
              <video autoplay muted loop playsinline aria-label="Distributed energy resource analysis showing solar potential across a city">
                <source src="/assets/video/RadiationCesiumView.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="feature-copy">
              <EditorialIcon name="distributed-energy" class="feature-icon" />
              <p>Match distributed energy resources to local demand and network needs.</p>
              <ul role="list">
                <li>Model solar, geothermal, district energy, and CHP.</li>
                <li>Coordinate storage and EV charging.</li>
                <li>Test demand response and smart building flexibility.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      </section>


    <section id="products">
      <div class="container" id="modules">
        <div class="section-header">
          <h2>Products</h2>
        </div>
        
        <div class="products-grid">
          {products.map((product) => {
            const href = "href" in product ? product.href : undefined;
            const Card = href ? "a" : "article";
            return (
              <Card class:list={["product-card", { "product-card-link": href }]} data-product={product.icon} href={href} aria-label={href ? product.name : undefined}>
                <EditorialIcon name={product.icon} class="product-icon" />
                <h3>{product.name}{href && <span class="product-link-mark" aria-hidden="true"> ↗</span>}</h3>
                <p>{product.summary}</p>
                <HoverPaper icon={product.icon} />
              </Card>
            );
          })}
        </div>
      </div>
    </section>
    
