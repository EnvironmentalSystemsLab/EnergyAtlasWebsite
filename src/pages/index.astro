---
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/site.css";
import themeScript from "../scripts/theme.js?raw";
import ribbonScript from "../scripts/ribbon.js?raw";
import EditorialIcon from "../components/EditorialIcon.astro";
import HoverPaper from "../components/HoverPaper.astro";

const products = [
  { icon: "mcp", name: "EnergyAtlas-MCP", summary: "Connect AI assistants to EnergyAtlas tools and city energy data." },
  { icon: "agent", name: "EnergyAtlas-Agent", summary: "Explore urban energy questions with an agentic modeling assistant." },
  { icon: "api", name: "EnergyAtlas-API", summary: "Bring energy models and simulation results into your own workflows." },
  { icon: "wiki", name: "EnergyAtlas-Wiki", summary: "Find guides, concepts, and examples for working with EnergyAtlas.", href: "https://energy-atlas.github.io/" },
] as const;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline set:html={themeScript}></script>
  <script is:inline set:html={ribbonScript}></script>
  <meta name="description" content="EnergyAtlas.io - Your city-scale digital twin for fast, validated urban energy insight. ISO-compliant UBEM platform with ~150× faster simulations." />
  
  <!-- Favicon -->
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/brand/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="EnergyAtlas.io - Digital Twin Tool for Urban Energy Insight" />
  <meta property="og:description" content="Your city-scale digital twin for fast, validated urban energy insight. ISO-compliant UBEM platform with ~150× faster simulations." />
  <meta property="og:url" content="https://energyatlas.io" />
  <meta property="og:image" content="https://energyatlas.io/brand/energyatlas-mark.svg" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content="EnergyAtlas.io - Digital Twin Tool for Urban Energy Insight" />
  <meta property="twitter:description" content="Your city-scale digital twin for fast, validated urban energy insight. ISO-compliant UBEM platform with ~150× faster simulations." />
  <meta property="twitter:image" content="https://energyatlas.io/brand/energyatlas-mark.svg" />

  <title>EnergyAtlas.io - Digital Twin Tool for Urban Energy Insight</title>
  
  <link rel="preload" href="/assets/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/cormorant-garamond-latin-500-italic.woff2" as="font" type="font/woff2" crossorigin />
</head>

<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  
  <header role="banner">
    <div class="container">
      <div class="header-content">
        <a href="#main" class="logo" aria-label="EnergyAtlas.io Home">
          <img src="/brand/energyatlas-mark.svg" alt="" />
          <span class="logo-text">EnergyAtlas.io</span>
        </a>
        
        <nav role="navigation" aria-label="Main navigation">
          <ul>
            <li><a href="#features"><span>Features</span></a></li>
            <li><a href="#products"><span>Products</span></a></li>
            <li><a href="#research"><span>Research</span></a></li>
            <li><a href="#media"><span>Media</span></a></li>
            <li><a href="#team"><span>Team</span></a></li>
            <li><a href="#demo"><span>Demo</span></a></li>
          </ul>
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" role="switch" aria-label="Dark theme" aria-checked="false" hidden>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5Z" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" role="banner">
      <video autoplay muted loop playsinline>
        <source src="/assets/video/Web.mp4" type="video/mp4">
      </video>
      <div class="container">
        <h1>EnergyAtlas.io</h1>
        <p class="hero-subtitle">agentic digital twins for<br /> city-scale energy insights.</p>
        
        <div class="cta-buttons">
          <a href="#features" class="btn btn-primary">explore features</a>
          <a href="https://energy-atlas.github.io/" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">wiki</a>
          <!-- <a href="#use-cases" class="btn btn-secondary">Explore Use Cases</a> -->
        </div>
      </div>
    </section>

